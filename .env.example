# EdgeLoop Environment Configuration

# Service Ports and Host
EDGELOOP_HOST=0.0.0.0
EDGELOOP_PORT=8000
DASHBOARD_PORT=8501

# Model and Storage Paths
EDGELOOP_CONFIG_PATH=configs/config.yaml
EDGELOOP_DB_PATH=artifacts/registry/edgeloop.db

# Device Preference: auto, cpu, mps, cuda
EDGELOOP_DEVICE=auto

# Security & Governance
EDGELOOP_API_TOKEN=edgeloop-dev-secret-token
EDGELOOP_DEV_MODE=true
